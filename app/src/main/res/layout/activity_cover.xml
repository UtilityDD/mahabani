<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cover_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    tools:context=".CoverActivity">

    <!-- This ImageView will hold your PNG logo -->
    <ImageView
        android:id="@+id/cover_image"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/loading_icon"
        app:tint="?attr/colorOnSurface"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45"
        tools:visibility="visible" />

    <!-- Bookshelf Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bookshelf_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/bookshelf_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bookshelf_bg"
            android:alpha="0.8"
            android:contentDescription="Bookshelf Background" />

        <!-- Dark overlay for blur effect - Reduced to 30% for clearer wood texture -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#4D000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Search Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#44FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#33FFFFFF"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/bookshelf_search_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:iconifiedByDefault="false"
                app:queryHint="Search book name..."
                app:queryBackground="@android:color/transparent"
                app:searchIcon="@drawable/ic_search"
                app:closeIcon="@drawable/ic_collapse" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Vertical ScrollView for stacked books -->
        <ScrollView
            android:id="@+id/books_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/search_card"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:id="@+id/shelf_books_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="100dp"
                android:paddingBottom="100dp"
                android:paddingStart="40dp"
                android:paddingEnd="40dp" />

        </ScrollView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_language"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:text="Language"
            android:textColor="?attr/colorOnSurface"
            app:icon="@drawable/ic_language"
            app:iconTint="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurfaceContainerHigh"
            app:elevation="6dp"
            app:contentPaddingStart="16dp"
            app:contentPaddingEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Floating Social Bar (Left Side) -->
        <LinearLayout
            android:id="@+id/social_floating_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Video Icon -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fab_video"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                android:clickable="true"
                android:focusable="true"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    app:tint="#FF0000"
                    android:src="@drawable/ic_play_arrow"
                    android:contentDescription="Watch Videos" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Facebook Icon -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fab_facebook"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                android:clickable="true"
                android:focusable="true"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    app:tint="#1877F2"
                    android:src="@drawable/ic_facebook"
                    android:contentDescription="Facebook Page" />
            </com.google.android.material.card.MaterialCardView>

            <!-- WhatsApp Icon -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fab_whatsapp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                android:clickable="true"
                android:focusable="true"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    app:tint="#25D366"
                    android:src="@drawable/ic_whatsapp"
                    android:contentDescription="WhatsApp Us" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tap_to_open_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Touch to Open"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/cover_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>